<Window x:Class="KE.AoC.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KE.AoC.App.ViewModels"
        Title="Advent of Code Runner"
        WindowStartupLocation="CenterScreen"
        MinWidth="747" MinHeight="879"
        SizeToContent="WidthAndHeight">
    <Window.Resources>

        <DataTemplate DataType="{x:Type vm:PartViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Width="320">
                <Button Command="{Binding RunCommand}"
                        Content="{Binding Part}"
                        ContentStringFormat="Run part {0}"
                        Padding="8, 4" Margin="0, 0, 8, 0" />
                <TextBox Text="{Binding Result}"
                         IsReadOnly="True"
                         Width="150"
                         HorizontalContentAlignment="Right"
                         VerticalContentAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="Black" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="Red" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock Text="{Binding Elapsed}"
                           Foreground="Gray"
                           Width="65"
                           TextAlignment="Right"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DayViewModel}">
            <StackPanel Orientation="Horizontal" Margin="0, 2">
                <TextBlock Text="{Binding Day, StringFormat='Day {0:D2}'}"
                           Width="65"
                           FontWeight="Medium"
                           VerticalAlignment="Center" />
                <ContentControl Content="{Binding Part1}" />
                <ContentControl Content="{Binding Part2}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:YearViewModel}">
            <DockPanel Margin="5">
                <Button DockPanel.Dock="Top"
                        Content="Run entire year"
                        Command="{Binding RunAllCommand}"
                        HorizontalAlignment="Left"
                        Padding="8, 4" Margin="0, 0, 0, 10" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Days}" />
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>

    </Window.Resources>

    <Grid Margin="5">
        <TabControl ItemsSource="{Binding Years}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Year}" FontSize="13" Padding="4, 2" />
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>
    </Grid>
</Window>
